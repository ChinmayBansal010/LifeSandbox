# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=[]

# Database (PostgreSQL recommended outside local development)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lifesandbox

# Authentication: development bypass is available only in development mode.
AUTH_MODE=development
AUTH_SECRET=
AUTH_ISSUER=
AUTH_AUDIENCE=

# LLM: mock is deterministic and credential-free. Nebius is preferred for configured deployments.
LLM_PROVIDER=mock
LLM_FALLBACK_PROVIDER=
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1000

# Research
RESEARCH_PROVIDER=disabled
TAVILY_API_KEY=

# Embedding (deterministic local hash only; no production semantic model yet)
EMBEDDING_PROVIDER=local_hash
EMBEDDING_DIMENSIONS=128

# Private Cloudflare R2 uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
UPLOAD_MAX_BYTES=10000000

# Optional infrastructure and telemetry (not required by local core)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=life-sandbox
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
SENTRY_DSN=
RATE_LIMIT_PER_MINUTE=60
